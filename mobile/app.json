{
  "expo": {
    "name": "EdmontonTrailMaps",
    "slug": "edmonton-trail-maps",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "edmontontrailmaps",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.edmontontrailmaps.app",
      "infoPlist": {
        "NSCameraUsageDescription": "The sign hunt uses your camera to photograph trail signs. Photos stay on your phone unless you choose to upload them.",
        "NSLocationWhenInUseUsageDescription": "Your location is used to show you on the trail map, verify sign captures, and record rides you choose to log."
      }
    },
    "android": {
      "package": "com.edmontontrailmaps.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#1E5E46",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1E5E46",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to show you on the trail map, verify sign captures, and record rides you choose to log."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The sign hunt uses your camera to photograph trail signs. Photos stay on your phone unless you choose to upload them."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
