# Copy to .env and fill in from your Supabase project (Settings -> API).
# Without these the app runs fully offline (guest mode, local-only data).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Android only: Google Maps SDK for Android key (read by app.config.js).
# Leave blank to skip — the Android map will be blank but the app still runs.
# iOS uses Apple Maps and needs no key.
GOOGLE_MAPS_ANDROID_API_KEY=
