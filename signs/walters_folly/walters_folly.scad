// Walters Folly  —  waltor okakêpâtisiwin  ("Walter's folly / foolishness")
// Plural "Walters" nods to the lineage of crossings here. Triptych icon:
// 1882 ferry / 1913 truss / 2017 arch (the recurring folly of (re)building it).
//
// FULL-BLEED B&W engraving + one accent (red), landscape:
//   * white plaque, two plain mounting holes (bored through plaque AND tile)
//   * the triptych fills the whole face to the border (clipped to the rounded
//     corners). It's a grayscale relief TILE (white = tallest, like IllumiStack's
//     white-over-black layering); previewed here via surface() on the heightmap.
//   * three RAISED titles overlaid top / middle / bottom in the accent colour:
//     translit (top), syllabics (centre, tallest), English (bottom).
//
// Per-part export: render one piece at a time with
//   openscad -D 'PART="plaque"' -o walters_folly_plaque.stl walters_folly.scad
// (PART: all | plaque | icon_grey | english | translit | syllabics)
//
// ---- IllumiStack settings for the production tile -------------------------
//   Source image : walters_folly_triptych_grayscale.png (1536x1024, 3:2)
//   Mode         : BW (black base + white layers) — white = tallest
//   Model size   : 150 x 100 mm (full bleed; matches PLQ_W x PLQ_H)
//   Layer height : 0.08 mm; 3-4 black base layers, then ~15 tonal layers
//   Then swap surface() in engraving_tile() for import("...illumistack.stl").
$fn = 48;

PART = "all";                          // overridden by -D for per-part export

// ---- geometry (mm) --------------------------------------------------------
PLQ_W = 138.0;   PLQ_H = 73.0;   PLQ_T = 1.2;   CORNER_R = 3.5;   // standard blank
HOLE_R = 2.1;    HOLE_Y = 18.5;                    // holes stacked on the vertical
                                                   // centreline (tree mount)
TILE_Z = 1.6;                                      // relief rise (line-art cameo)
EMBED  = 0.3;                                      // titles sink into the plaque

PLAQUE_RGB = [0.910, 0.882, 0.812];    // cream / white
TILE_RGB   = [0.760, 0.600, 0.320];    // brass — full-plaque raised relief
ACCENT_RGB = [0.753, 0.224, 0.169];    // red accent for the three titles

// heightmap is pre-INVERTED + edge-cropped: dark objects (bridges/ferry/trees)
// are now the BRIGHT/TALL pixels, so they stick UP out of the recessed sky/water.
HEIGHTMAP = "walters_folly_heightmap.png";

// rounded-rectangle plaque footprint (2D), reused for clip + plaque body
module footprint() {
  offset(r=CORNER_R) offset(r=-CORNER_R) square([PLQ_W, PLQ_H], center=true);
}

module holes() {
  for (sy = [-1, 1])
    translate([0, sy*HOLE_Y, -1]) cylinder(h=PLQ_T + TILE_Z + 3, r=HOLE_R);
}

module blank_plaque() {
  difference() { linear_extrude(height=PLQ_T) footprint(); holes(); }
}

// The engraving IS the plaque now: a single rounded-corner solid (backing +
// raised relief + bored screw holes) generated by make_relief.py (heightfield
// column mesh, no CGAL). We import it here for preview/assembly.
module engraving_tile() {
  import("walters_folly_engraving.stl", convexity=10);
}

// ---- titles (overlaid; tall enough to clear the engraving relief) ---------
module translit_text() {            // top (clear sky band; year labels cropped out)
  translate([0, 29.0, PLQ_T - EMBED])
    linear_extrude(height=TILE_Z + 0.8 + EMBED)
      text("waltor okakêpâtisiwin", size=5.5, halign="center", valign="center",
           font="Helvetica Neue:style=Bold");
}
module english_text() {             // bottom
  translate([0, -29.0, PLQ_T - EMBED])
    linear_extrude(height=TILE_Z + 0.8 + EMBED)
      text("Walters Folly", size=7.0, halign="center", valign="center",
           font="Helvetica Neue:style=Bold");
}
module syllabics_text() {           // centre, tallest
  translate([0, 0, PLQ_T - EMBED])
    linear_extrude(height=TILE_Z + 1.4 + EMBED)
      text("ᐗᓪᑐᕒ ᐅᑲᑫᐹᑎᓯᐎᐣ", size=7.0, halign="center", valign="center",
           font="Euphemia UCAS:style=Bold");
}

// ---- dispatch -------------------------------------------------------------
module all() {
  union() {
    color(TILE_RGB)   engraving_tile();   // merged plaque + relief body
    color(ACCENT_RGB) translit_text();
    color(ACCENT_RGB) english_text();
    color(ACCENT_RGB) syllabics_text();
  }
}

if      (PART == "plaque")    blank_plaque();
else if (PART == "icon_grey") engraving_tile();
else if (PART == "english")   english_text();
else if (PART == "translit")  translit_text();
else if (PART == "syllabics") syllabics_text();
else                          all();
